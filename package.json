{
  "name": "purelane-theme",
  "private": true,
  "description": "Purelane homepage sections on Shopify Dawn. Tooling only; nothing here is uploaded to Shopify.",
  "type": "module",
  "scripts": {
    "extract": "node tools/extract-prototype-assets.mjs",
    "seed:images": "node tools/rasterize-seed-images.mjs",
    "seed": "node store-seed/seed.mjs",
    "check": "node tools/theme-check.mjs",
    "preview": "node tools/preview/render.mjs && node tools/preview/serve.mjs",
    "compare": "node tools/preview/render.mjs && node tools/preview/compare.mjs",
    "behaviour": "node tools/preview/render.mjs && node tools/preview/behaviour.mjs",
    "qa": "node tools/preview/render.mjs && node tools/preview/qa.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@shopify/theme-check-node": "^3.29.0",
    "liquidjs": "^10.29.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.11.0"
  }
}
