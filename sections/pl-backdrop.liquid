{% comment %}
  Purelane backdrop: fixed, decorative water scene behind the page.
  Position in the template does not matter (it is position: fixed); each
  pl-* section sets which scene/depth it wants via its "Background depth"
  setting, so reordering sections keeps the crossfade correct.
{% endcomment %}
{{ 'pl-backdrop.css' | asset_url | stylesheet_tag }}

<pl-backdrop data-d="1" data-parallax="{{ section.settings.parallax }}" aria-hidden="true">
  <i class="pl-scene pl-s1 is-on"></i>
  <i class="pl-scene pl-s2"></i>
  <i class="pl-scene pl-s3"></i>
  <i class="pl-scene pl-s4"></i>

  {%- if section.settings.water -%}
    <span class="pl-water">
      {%- for layer in (1..4) -%}
        {%- liquid
          case layer
            when 1
              assign key = 'a'
            when 2
              assign key = 'b'
            when 3
              assign key = 'c'
            else
              assign key = 's'
          endcase
          assign file = 'pl-water-' | append: key | append: '.svg'
        -%}
        <span class="pl-wl pl-wl-{{ key }}">
          <img src="{{ file | asset_url }}" alt="" width="1800" height="1100" decoding="async" fetchpriority="low">
        </span>
      {%- endfor -%}

      {%- if section.settings.bubbles -%}
        <span class="pl-bub">
          <span style="--x:91.9%;--s:6.7px;--dur:21.5s;--dly:19.0s;--drift:-11px"></span>
          <span style="--x:43.4%;--s:5.7px;--dur:26.8s;--dly:16.1s;--drift:-11px"></span>
          <span style="--x:96.6%;--s:6.2px;--dur:13.7s;--dly:10.3s;--drift:38px"></span>
          <span style="--x:6.0%;--s:3.6px;--dur:24.4s;--dly:10.6s;--drift:3px"></span>
          <span style="--x:70.3%;--s:3.3px;--dur:20.9s;--dly:9.2s;--drift:-39px"></span>
          <span style="--x:67.7%;--s:4.0px;--dur:27.0s;--dly:16.5s;--drift:-5px"></span>
          <span style="--x:2.1%;--s:7.1px;--dur:22.0s;--dly:3.1s;--drift:-37px"></span>
          <span style="--x:69.4%;--s:8.1px;--dur:21.9s;--dly:10.7s;--drift:-24px"></span>
          <span style="--x:64.1%;--s:8.2px;--dur:17.3s;--dly:9.0s;--drift:2px"></span>
          <span style="--x:21.8%;--s:7.1px;--dur:15.7s;--dly:18.4s;--drift:-13px"></span>
          <span style="--x:61.9%;--s:6.6px;--dur:26.3s;--dly:7.2s;--drift:-23px"></span>
          <span style="--x:45.9%;--s:8.9px;--dur:24.3s;--dly:7.2s;--drift:20px"></span>
          <span style="--x:52.5%;--s:3.3px;--dur:20.2s;--dly:19.6s;--drift:-31px"></span>
          <span style="--x:11.1%;--s:7.9px;--dur:20.4s;--dly:10.8s;--drift:-40px"></span>
          <span style="--x:7.6%;--s:6.4px;--dur:19.5s;--dly:0.2s;--drift:-26px"></span>
          <span style="--x:18.6%;--s:9.0px;--dur:24.5s;--dly:8.7s;--drift:13px"></span>
        </span>
      {%- endif -%}
    </span>
  {%- endif -%}

  <i class="pl-vig"></i>
</pl-backdrop>

<script src="{{ 'pl-backdrop.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Purelane backdrop",
  "tag": "div",
  "class": "pl-backdrop-section",
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "Fixed water background shown behind every Purelane section. Its place in the section list does not matter. Each Purelane section picks its own background depth."
    },
    {
      "type": "checkbox",
      "id": "water",
      "label": "Show water light",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "bubbles",
      "label": "Show bubbles",
      "info": "Hidden on mobile to save battery.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "parallax",
      "label": "Parallax on scroll and mouse",
      "info": "Always off for visitors who ask for reduced motion.",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Purelane backdrop"
    }
  ]
}
{% endschema %}
