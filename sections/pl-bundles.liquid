{% comment %}
  Purelane bundles: "Build your bundle" intro panel + pick-any-N tiers.

  Each tier is a real product (e.g. "Any 3 products" at ₹499, compare-at
  ₹897), so price, compare-at and stock come from Shopify. Tier size comes
  from the product's custom.bundle_size metafield (falling back to its
  bundle item count); the per-product price is calculated from both.
  The product row shows custom.bundle_items, or the featured image.
{% endcomment %}
{{ 'pl-bundles.css' | asset_url | stylesheet_tag }}

<div
  class="pl pl-sec pl-bundles"
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handle }}"
  {% endif %}
  data-pl-scene="{{ section.settings.scene }}"
>
  <div class="pl-wrap">
    {%- if section.settings.kicker != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="pl-bundles__intro pl-glass pl-sec-pad pl-rv">
        {%- render 'pl-section-head',
          kicker: section.settings.kicker,
          heading: section.settings.heading,
          lede: section.settings.text,
          class: 'pl-head--flush'
        -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="pl-tiers" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign product = block.settings.product
            # Stagger like the design: none, d2, d3 (then repeat).
            assign mod = forloop.index0 | modulo: 3
            assign reveal = 'pl-rv'
            if mod > 0
              assign d = mod | plus: 1
              assign reveal = 'pl-rv pl-rv-d' | append: d
            endif
          -%}
          <li {{ block.shopify_attributes }}>
            {%- if product == blank -%}
              {%- if request.design_mode -%}
                <div class="pl-tier pl-glass">
                  <p class="pl-editor-note">{{ 'purelane.bundles.editor_empty' | t }}</p>
                </div>
              {%- endif -%}
              {%- continue -%}
            {%- endif -%}

            {%- liquid
              assign items = product.metafields.custom.bundle_items.value
              assign size = product.metafields.custom.bundle_size.value | default: items.size | default: 1

              # Per-product price, rounded half down to a whole unit: never
              # overstates, and matches the design (349/2 -> 174, 799/5 -> 160).
              assign per_unit = product.price | divided_by: size | plus: 49 | divided_by: 100 | times: 100
              assign per_money = per_unit | money_without_trailing_zeros
              assign per_text = section.settings.per_item | escape | replace: '[price]', per_money

              assign features = block.settings.features | newline_to_br | split: '<br />'
              assign link = block.settings.button_link | default: product.url
            -%}
            <article
              class="pl-tier pl-glass pl-lift {{ reveal }}{% if block.settings.featured %} pl-is-featured{% endif %}"
              aria-label="{{ product.title | escape }}"
            >
              {%- if block.settings.tag != blank -%}
                <span class="pl-pill pl-tier__tag">{{ block.settings.tag | escape }}</span>
              {%- endif -%}

              <div class="pl-tierpix{% if items.size > 3 %} pl-tierpix--many{% endif %}" aria-hidden="true">
                {%- if items.size > 0 -%}
                  {%- for item in items limit: 5 -%}
                    {%- render 'pl-product-media',
                      product: item,
                      height: 62,
                      class: 'pl-pimg pl-tierpix__img',
                      tile_class: 'pl-tierpix__tile',
                      decorative: true
                    -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- render 'pl-product-media',
                    product: product,
                    height: 62,
                    class: 'pl-pimg pl-tierpix__img',
                    tile_class: 'pl-tierpix__tile',
                    decorative: true
                  -%}
                {%- endif -%}
              </div>

              <div class="pl-tier__qty">
                {{- size }} <small>{{ section.settings.qty_label | escape }}</small>
              </div>
              <div class="pl-tier__price">{% render 'pl-price', product: product, part: 'prices' %}</div>
              {%- if section.settings.per_item != blank -%}
                <p class="pl-body-s pl-tier__per">{{ per_text }}</p>
              {%- endif -%}

              {%- assign has_features = false -%}
              {%- for f in features -%}
                {%- if f != blank -%}{%- assign has_features = true -%}{%- break -%}{%- endif -%}
              {%- endfor -%}
              {%- if has_features -%}
                <ul class="pl-tier__list">
                  {%- for f in features -%}
                    {%- assign line = f | strip -%}
                    {%- if line != blank -%}
                      <li>{% render 'pl-icon', name: 'check', stroke: 2.4 %}{{ line | escape }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if product.available -%}
                <a
                  class="pl-btn pl-btn--block {% if block.settings.featured %}pl-btn--primary{% else %}pl-btn--ghost{% endif %}"
                  href="{{ link }}"
                >
                  {{- block.settings.button_label | escape -}}
                  {%- if block.settings.featured %} {% render 'pl-icon', name: 'arrow' %}{% endif -%}
                </a>
              {%- else -%}
                <button type="button" class="pl-btn pl-btn--ghost pl-btn--block" disabled>
                  {{- 'products.product.sold_out' | t -}}
                </button>
              {%- endif -%}
            </article>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Purelane bundles",
  "tag": "section",
  "class": "pl-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    },
    {
      "type": "header",
      "content": "Tiers"
    },
    {
      "type": "paragraph",
      "content": "Each tier is a product. Its size comes from the product's \"Bundle size\" metafield, and the pictures from its \"Bundle items\" metafield."
    },
    {
      "type": "text",
      "id": "qty_label",
      "label": "Label under the number",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "per_item",
      "label": "Per-product price text",
      "info": "[price] is replaced with the price divided by the bundle size. Leave empty to hide.",
      "default": "Flat [price] per product"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "info": "Lets menus link here, e.g. /#bundles.",
      "default": "bundles"
    },
    {
      "type": "select",
      "id": "scene",
      "label": "Background depth",
      "info": "Needs the Purelane backdrop section.",
      "options": [
        { "value": "1", "label": "Surface" },
        { "value": "2", "label": "Shallow" },
        { "value": "3", "label": "Deep" },
        { "value": "4", "label": "Deepest" }
      ],
      "default": "3"
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Bundle product"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Starter"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Highlight this tier",
          "default": false
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features",
          "info": "One per line.",
          "default": "Pick any two products\nFree shipping across India"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link",
          "info": "Defaults to the bundle product."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": { "tag": "Starter", "features": "Pick any two products\nFree shipping across India" }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Most popular",
            "featured": true,
            "features": "Pick any three products\nCovers kitchen and laundry\nFree shipping across India"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Whole home",
            "features": "Pick any five products\nEvery room in one order\nFree shipping across India"
          }
        }
      ]
    }
  ]
}
{% endschema %}
