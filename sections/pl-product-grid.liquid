{% comment %}
  Purelane product grid ("Bestsellers / Loved by 30,000 homes").
  Products, prices, stock, badges and ratings all come from the chosen
  collection; nothing about a product is typed into the section.
{% endcomment %}
{{ 'pl-product-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
  assign heading_id = 'pl-grid-heading-' | append: section.id
-%}

<div
  class="pl pl-sec pl-grid"
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handle }}"
  {% endif %}
  data-pl-scene="{{ section.settings.scene }}"
>
  <div class="pl-wrap">
    {%- render 'pl-section-head',
      kicker: section.settings.kicker,
      heading: section.settings.heading,
      heading_id: heading_id,
      show_rule: section.settings.show_rule,
      class: 'pl-rv'
    -%}

    {%- if collection != blank and collection.products_count > 0 -%}
      <ul class="pl-shelf" role="list" aria-labelledby="{{ heading_id }}">
        {%- for product in collection.products limit: limit -%}
          {%- liquid
            assign mod = forloop.index0 | modulo: 4
            assign reveal = 'pl-rv'
            if mod > 0
              assign reveal = 'pl-rv pl-rv-d' | append: mod
            endif
          -%}
          <li>
            {%- render 'pl-product-card',
              product: product,
              section_id: section.id,
              saving_label: section.settings.saving_label,
              show_rating: section.settings.show_rating,
              class: reveal
            -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="pl-editor-note">{{ 'purelane.grid.editor_empty' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Purelane product grid",
  "tag": "section",
  "class": "pl-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show leaf divider",
      "default": true
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "paragraph",
      "content": "Badges come from each product's \"Badge\" metafield (custom.badge). Ratings come from the standard product rating metafields your reviews app fills in."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "text",
      "id": "saving_label",
      "label": "Saving text",
      "info": "[saving] is replaced with the calculated percentage.",
      "default": "[saving] off"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "info": "Lets menus link here, e.g. /#shop.",
      "default": "shop"
    },
    {
      "type": "select",
      "id": "scene",
      "label": "Background depth",
      "info": "Needs the Purelane backdrop section.",
      "options": [
        { "value": "1", "label": "Surface" },
        { "value": "2", "label": "Shallow" },
        { "value": "3", "label": "Deep" },
        { "value": "4", "label": "Deepest" }
      ],
      "default": "3"
    }
  ],
  "presets": [
    {
      "name": "Purelane product grid"
    }
  ]
}
{% endschema %}
