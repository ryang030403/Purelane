{% comment %}
  Star row for a rating. Exposed to assistive tech as one image with a
  spoken value ("5 out of 5 stars") instead of five "black star" glyphs.

  Accepts:
  - rating: {Number} e.g. 4.8 (required)
  - scale: {Number} maximum (optional, default 5)
  - class: {String} (optional)

  Usage:
  {% render 'pl-stars', rating: review.rating.value.rating, class: 'pl-rcard__stars' %}
{% endcomment %}
{%- liquid
  assign scale = scale | default: 5 | round
  assign filled = rating | round
-%}
<span
  class="pl-stars {{ class }}"
  role="img"
  aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating, rating_max: scale }}"
>
  {%- for i in (1..scale) -%}
    {%- if i <= filled -%}&#9733;{%- else -%}&#9734;{%- endif -%}
  {%- endfor -%}
</span>
